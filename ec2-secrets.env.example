# =============================================================================
# ec2-secrets.env.example — template for set-ec2-secrets.sh
# -----------------------------------------------------------------------------
# Copy this to ec2-secrets.env (gitignored, NEVER committed) and fill in YOUR
# EC2 instance's details, then run:
#
#     cp ec2-secrets.env.example ec2-secrets.env
#     # ... edit ec2-secrets.env ...
#     ./set-ec2-secrets.sh
#
# EC2_SSH_KEY_FILE can point at your .pem file so the key itself never has to
# be pasted or stored in this file. Alternatively pass it on the command line:
#
#     ./set-ec2-secrets.sh --key ~/.ssh/mern-ec2-key.pem
#
# Run it again whenever the EC2 instance is replaced (the public IP changes).
# =============================================================================

# --- EC2 instance ---
EC2_HOST=1.2.3.4                    # public IP of your EC2 instance
EC2_USER=ec2-user                   # SSH login user (ec2-user for Amazon Linux)

# --- SSH key ---
# Path to your .pem file — the WHOLE file (BEGIN to END) becomes EC2_SSH_KEY.
# Leave unset to paste the key interactively instead.
EC2_SSH_KEY_FILE=~/.ssh/mern-ec2-key.pem
