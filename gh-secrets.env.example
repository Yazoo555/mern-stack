# =============================================================================
# gh-secrets.env.example — template for set-gh-secrets.sh
# -----------------------------------------------------------------------------
# Copy this to gh-secrets.env (gitignored, NEVER committed) and fill in YOUR
# current values, then run:
#
#     cp gh-secrets.env.example gh-secrets.env
#     # ... edit gh-secrets.env ...
#     ./set-gh-secrets.sh
#
# Run it again after every login — the AWS lab credentials change each time
# the lab restarts, and your Docker Hub token may be rotated too.
# =============================================================================

# --- AWS: paste the [default] block from the lab's "AWS Details" panel -------
aws_access_key_id=AKIAXXXXXXXXXXXXXXXX
aws_secret_access_key=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
aws_session_token=IQoJb3JpZ2luX2Vj...          # temporary lab creds ALWAYS include this

# --- Docker Hub ---------------------------------------------------------------
DOCKERHUB_USERNAME=yazoo555
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxx
